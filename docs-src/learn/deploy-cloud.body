  {"id": "b", "x": 180, "y": 30, "w": 150, "h": 60, "title": "2. Login", "kind": "cf", "sub": "wrangler login"},
  {"id": "c", "x": 350, "y": 30, "w": 150, "h": 60, "title": "3. Database", "kind": "db", "sub": "d1 create + migrate"},
  {"id": "d", "x": 520, "y": 30, "w": 150, "h": 60, "title": "4. First deploy", "kind": "cf", "sub": "get the URL"},
  {"id": "e", "x": 690, "y": 30, "w": 140, "h": 60, "title": "5. Keys", "kind": "note", "sub": "VAPID + token key"},
  {"id": "f", "x": 690, "y": 160, "w": 140, "h": 60, "title": "6. Atlassian app", "kind": "ext", "sub": "callback, scopes"},
  {"id": "g", "x": 520, "y": 160, "w": 150, "h": 60, "title": "7. Client id/secret", "kind": "note", "sub": "config + secret"},
  {"id": "h", "x": 350, "y": 160, "w": 150, "h": 60, "title": "8. Deploy + sign in", "kind": "cf", "sub": "verify live"},
