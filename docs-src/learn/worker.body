 ],
 "edges": [
  {"from": "idx", "to": "csrf"},
  {"from": "csrf", "to": "sess"},
  {"from": "sess", "to": "rl"},
  {"from": "rl", "to": "tok"},
  {"from": "tok", "to": "api"},
  {"from": "api", "to": "core"},
  {"from": "core", "to": "resp"},
  {"from": "sess", "to": "d1", "dashed": true, "via": [[410, 110], [410, 268]]},
